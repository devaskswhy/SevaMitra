# Test-only database connection — used exclusively by `npm test` (see
# jest.config.js's setupFiles). Deliberately NOT the same file as .env,
# which holds live production credentials in local dev setups: the test
# suite must never be able to accidentally connect to production.
#
# Matches docker-compose.yml's postgres service exactly, so `docker-compose
# up -d` is all that's needed locally before running tests.
DATABASE_URL=postgresql://user:password@localhost:5432/sevamitra?schema=public
NODE_ENV=test
