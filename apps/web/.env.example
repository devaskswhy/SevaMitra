# Backend API base URL (see apps/api). Include or omit the trailing
# /api — app code normalizes either form.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Groq API key for the SevaSahayak chat widget (apps/web/app/api/chat/route.ts).
# Leave unset and the widget degrades gracefully.
GROQ_API_KEY=

# --- Google OAuth (admin/coordinator sign-in, apps/web/app/api/auth/[...nextauth]/route.ts) ---
# Both come from a Google Cloud Console OAuth 2.0 Client ID (APIs &
# Services > Credentials > Create OAuth client ID > Web application).
# Add an Authorized redirect URI of <your-app-url>/api/auth/callback/google
# (e.g. http://localhost:3001/api/auth/callback/google for local dev) and
# an Authorized JavaScript origin of <your-app-url> (no path).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Any random string — used to sign/encrypt NextAuth's session JWT.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=

# This app's own base URL. http://localhost:3001 for local dev (Next.js
# falls back to 3001 if 3000 is already in use), or the deployed URL
# (e.g. https://seva-mitra-wheat.vercel.app) in production.
NEXTAUTH_URL=http://localhost:3001
